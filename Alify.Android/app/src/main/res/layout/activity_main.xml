<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Brand Header with Settings Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hujjify"
                    android:textColor="@color/spotify_green"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conscious Music &amp; Spotify Lyric Sentinel"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings &amp; Credentials"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/spotify_light_text" />
        </LinearLayout>

        <!-- Setup Notice Card (Visible when Spotify Client ID is not yet configured) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSetupNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp"
            app:strokeColor="@color/accent_blue"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Developer Client ID Required"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Spotify limits unverified developer apps. Add your personal Spotify Developer Client ID (free 2-minute setup) for unlimited access."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetupClientId"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:text="Configure Client ID &amp; Keys"
                    android:textColor="@color/spotify_light_text"
                    app:strokeColor="@color/accent_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Playback & Protection Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Ready to Connect"
                    android:textColor="@color/spotify_sub_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No track playing"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect Spotify to start monitoring"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSafetyBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/badge_clean"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="✓ Status: Clean"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Button to Open Lyrics & Stance Audit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewLyrics"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="📜 View Lyrics &amp; Annotations"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/spotify_green" />

                <!-- Active Filter Configuration Display -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/spotify_black" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActiveEthos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Active Ethos: Islamic (10/10)"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvChangeSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Change"
                        android:textColor="@color/spotify_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Protection Dashboard & Analytics Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header with Title and Reset Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 Protection Analytics"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnResetStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="Reset Stats"
                        android:textColor="@color/spotify_sub_text"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 4 Metrics Grid: Audited, Skipped, Flagged, No Lyrics -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:layout_marginBottom="16dp">

                    <!-- Audited / Played -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:padding="8dp"
                        android:layout_marginEnd="3dp">

                        <TextView
                            android:id="@+id/tvStatPlayed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/spotify_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audited"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Clean -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:padding="8dp"
                        android:layout_marginHorizontal="2dp">

                        <TextView
                            android:id="@+id/tvStatClean"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/spotify_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clean"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Flagged & Skipped -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:padding="8dp"
                        android:layout_marginHorizontal="2dp">

                        <TextView
                            android:id="@+id/tvStatFlagged"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/flag_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skipped"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- No Lyrics -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/stat_box_background"
                        android:padding="8dp"
                        android:layout_marginStart="3dp">

                        <TextView
                            android:id="@+id/tvStatNoLyrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Lyrics"
                            android:textColor="@color/spotify_sub_text"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/spotify_black"
                    android:layout_marginBottom="12dp" />

                <!-- Recent Activity Feed Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Song Audits"
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Recent Tracks Container -->
                <LinearLayout
                    android:id="@+id/layoutRecentTracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoRecentActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No songs audited yet. Play music on Spotify to see activity."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp"
                    android:fontStyle="italic"
                    android:paddingVertical="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/spotify_green"
            android:text="Connect with Spotify"
            android:textColor="@color/spotify_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleProtection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/accent_blue"
            android:text="Start Halal Protection"
            android:textColor="@color/spotify_light_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>
