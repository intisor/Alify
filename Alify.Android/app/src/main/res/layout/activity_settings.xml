<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/spotify_light_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Settings &amp; Credentials"
                android:textColor="@color/spotify_light_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTop"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="@color/spotify_green"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section 1: Spotify Developer BYOK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="1. Spotify Developer Client ID (BYOK)"
            android:textColor="@color/spotify_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Why is this needed? Spotify limits testing apps to 25 accounts. Using your own personal Developer Client ID gives you unlimited, unrestricted playback monitoring with zero whitelist caps."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="13sp" />

                <!-- Step 1 Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenSpotifyDashboard"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="1. Open Spotify Dashboard ↗"
                    android:textColor="@color/spotify_light_text"
                    app:strokeColor="@color/spotify_sub_text" />

                <!-- Step 2 Copy URI Box -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="2. Add this Redirect URI in your app settings:"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/spotify_black"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvRedirectUri"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="hujjify://callback"
                        android:textColor="@color/spotify_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnCopyRedirectUri"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy URI"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/spotify_light_text" />
                </LinearLayout>

                <!-- Step 3 Input Client ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="3. Paste your Client ID:"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="13sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSpotifyClientId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Spotify Client ID"
                    app:boxBackgroundColor="@color/spotify_black"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="@color/spotify_green"
                    app:endIconMode="clear_text"
                    app:hintTextColor="@color/spotify_sub_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSpotifyClientId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: AI Semantic Analysis Engine -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="2. AI Semantic Engine (BYOK)"
            android:textColor="@color/spotify_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbEnableAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Enable AI semantic scanning"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="De-cloaks coded slang, Yoruba/Pidgin double entendres, and suggestive subtext that keyword filters miss."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp" />

                <!-- API Key Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAiApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="AI API Key (Gemini, OpenRouter, Groq)"
                    app:boxBackgroundColor="@color/spotify_black"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="@color/spotify_green"
                    app:endIconMode="password_toggle"
                    app:helperText="Supports Gemini (AIza...), OpenRouter (sk-...), Groq (gsk_...)"
                    app:helperTextTextColor="@color/spotify_sub_text"
                    app:hintTextColor="@color/spotify_sub_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAiApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Engine Mode Selection -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="ANALYSIS ENGINE MODE"
                    android:textColor="@color/spotify_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spAnalysisMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/btn_dropdown" />

                <TextView
                    android:id="@+id/tvAnalysisModeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="AI Semantic Engine is authoritative; regex runs only as offline fallback."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="11sp" />

                <!-- Free Key Helper Links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetGeminiKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:text="Get Free Google Gemini Key (AI Studio) ↗"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetGroqKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:text="Get Free Groq Key (Fast Llama 3.3) ↗"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGetOpenRouterKey"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:text="Get Free OpenRouter Key ↗"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: Ethos & Worldview Filter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="3. Ethos &amp; Strictness Filter"
            android:textColor="@color/spotify_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 Chat-to-Filter (Natural Language Intent)"
                    android:textColor="@color/spotify_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Describe what you want or don't want to hear. The AI will enforce your exact boundaries."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomEthosPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Tell Hujjify what to allow or skip..."
                    app:boxBackgroundColor="@color/spotify_black"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="@color/spotify_green"
                    app:hintTextColor="@color/spotify_sub_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomEthosPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lines="3"
                        android:maxLines="6"
                        android:textColor="@color/spotify_light_text"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Ethos Worldview Profile"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spProfileSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@android:drawable/btn_dropdown" />

                <TextView
                    android:id="@+id/tvStrictnessLabelSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Strictness Level: 10 / 10"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/sbStrictnessSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="10"
                    android:min="1"
                    android:progress="10" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbExplicitSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="false"
                    android:text="Skip Spotify Explicit [E] tracks"
                    android:textColor="@color/spotify_light_text" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 4: App Version & Updates -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="4. App Version &amp; Updates"
            android:textColor="@color/spotify_green"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/spotify_dark_card"
            app:cardCornerRadius="12dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Installed Version: v1.3.0"
                    android:textColor="@color/spotify_light_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Open-source music stance filter &amp; lyric auditor."
                    android:textColor="@color/spotify_sub_text"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdates"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="🔄 Check for Updates on GitHub"
                    android:textColor="@color/spotify_light_text"
                    app:strokeColor="@color/spotify_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/spotify_green"
            android:text="Save Settings"
            android:textColor="@color/spotify_black"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>
