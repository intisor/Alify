@page
@model Alify.Pages.DashboardModel
@using SpotifyAPI.Web
@{
    ViewData["Title"] = "Music Dashboard";
}

<!-- Update Notification Banner -->
<div id="updateBanner" class="alert alert-info py-2 px-3 mb-2 d-none d-flex justify-content-between align-items-center" style="border-radius: 8px; font-size: 0.85rem;">
    <span>🚀 <strong>Update Available:</strong> A new version of Alify (<span id="latestVersionTag"></span>) is available!</span>
    <a id="updateDownloadLink" href="https://github.com/intisor/Alify/releases/latest" target="_blank" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem;">Download Update</a>
</div>

<!-- Top Control & Status Bar -->
<div class="control-bar mt-2">
    <div class="d-flex align-items-center gap-3">
        <span class="section-label mb-0">Monitor Status:</span>
        @if (Model.IsMonitoring)
        {
            <span class="pill pill-green">● Active</span>
        }
        else
        {
            <span class="pill">○ Inactive</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <span class="text-muted" style="font-size: 0.85rem;">@Model.StatusMessage</span>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="post" class="d-inline">
            @if (Model.IsMonitoring)
            {
                <button type="submit" asp-page-handler="StopMonitor" class="btn-flat btn-flat-danger">Stop Monitoring</button>
            }
            else
            {
                <button type="submit" asp-page-handler="StartMonitor" class="btn-flat">Start Monitoring</button>
            }
        </form>
        <form method="post" class="d-inline">
            <button type="submit" asp-page-handler="RefreshData" class="btn-flat btn-flat-secondary">Refresh Queue</button>
        </form>
    </div>
</div>

<!-- Content & Lyric Filter Settings -->
<div class="clean-panel mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <span class="section-label mb-1">Content &amp; Worldview Filter Settings</span>
            <div class="text-muted" style="font-size: 0.85rem;">
                Configure religious, family, or custom ethos filters with 1–10 strictness and Gemini 2.5 LLM semantic scanning.
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mt-sm-0">
            <span class="pill pill-blue">@Model.FilterPreferences.Profile Profile</span>
            <span class="pill pill-green">Strictness: @Model.FilterPreferences.StrictnessLevel / 10</span>
            @if (Model.FilterPreferences.EnableGeminiLLM)
            {
                <span class="pill pill-green">● Gemini 2.5 Active</span>
            }
            else
            {
                <span class="pill">○ Gemini LLM Off</span>
            }

            @if (Model.FilterPreferences.FilterSpotifyExplicit)
            {
                <span class="pill pill-red">Explicit: Skip</span>
            }
            else
            {
                <span class="pill pill-green">Explicit: Allow</span>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="SaveFilterPreferences">
        <!-- Top Row: Worldview Profile, Strictness Scale, and Gemini LLM -->
        <div class="row g-3 mb-3">
            <!-- Worldview Profile Dropdown -->
            <div class="col-md-5">
                <div class="filter-option-box">
                    <label class="filter-title mb-1 d-block" for="profileSelect">Worldview / Ethos Profile</label>
                    <select asp-for="FilterPreferences.Profile" class="filter-select" id="profileSelect">
                        <option value="General">General Safety (Standard Content Filter)</option>
                        <option value="Islamic">Islamic Ethos (Halal: Shirk/Blasphemy, Intoxicants, Fahisha/Sexual, Violence)</option>
                        <option value="Christian">Christian Ethos (Biblical: Blasphemy, Demonic/Occult, Immorality, Violence)</option>
                        <option value="FamilyFriendly">Family &amp; Child Safe (Zero Vulgarity, Sex, Drugs, Violence)</option>
                        <option value="Custom">Custom Rules (Manual Toggles Below)</option>
                    </select>
                    <p class="filter-desc" style="margin-left: 0; margin-top: 0.5rem;">
                        Select a guided religious or family-friendly profile to automatically configure topic guardrails.
                    </p>
                </div>
            </div>

            <!-- Strictness Level (1 - 10) -->
            <div class="col-md-4">
                <div class="filter-option-box">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="filter-title">Strictness Level (1–10)</span>
                        <span class="pill pill-blue" id="strictnessVal">@Model.FilterPreferences.StrictnessLevel</span>
                    </div>
                    <input type="range" min="1" max="10" asp-for="FilterPreferences.StrictnessLevel" class="filter-range" id="strictnessSlider" oninput="document.getElementById('strictnessVal').textContent = this.value;" />
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.7rem; margin-top: 0.25rem;">
                        <span>1 (Lenient)</span>
                        <span>5 (Standard)</span>
                        <span>10 (Zero-Tolerance)</span>
                    </div>
                    <p class="filter-desc" style="margin-left: 0; margin-top: 0.4rem;">
                        Levels 7–10 trigger immediate skips even on historical storytelling or casual mentions.
                    </p>
                </div>
            </div>

            <!-- Gemini 2.5 Flash LLM Verification -->
            <div class="col-md-3">
                <div class="filter-option-box">
                    <label class="filter-checkbox-label">
                        <input type="checkbox" asp-for="FilterPreferences.EnableGeminiLLM" class="filter-checkbox" />
                        <span class="filter-title">Gemini 2.5 Flash AI</span>
                    </label>
                    <p class="filter-desc" style="margin-left: 0; margin-top: 0.5rem;">
                        Uses Google Gemini 2.5 Flash LLM for deep semantic contextual evaluation.
                    </p>
                </div>
            </div>
        </div>

        <!-- Second Row: Fine-Grained Topic Checkboxes -->
        <div class="row g-3 mb-3">
            <!-- Spotify Metadata Explicit -->
            <div class="col-md-4">
                <div class="filter-option-box">
                    <label class="filter-checkbox-label">
                        <input type="checkbox" asp-for="FilterPreferences.FilterSpotifyExplicit" class="filter-checkbox" />
                        <span class="filter-title">Spotify Explicit Tag [E]</span>
                    </label>
                    <p class="filter-desc">Skip tracks marked with Spotify's official explicit content tag.</p>
                </div>
            </div>

            <!-- Violence Rules -->
            <div class="col-md-4">
                <div class="filter-option-box">
                    <div class="fw-bold mb-2" style="font-size: 0.85rem; color: #111;">Violence &amp; Weapons</div>
                    
                    <label class="filter-checkbox-label">
                        <input type="checkbox" asp-for="FilterPreferences.FilterViolenceEndorsed" class="filter-checkbox" />
                        <span class="filter-title">Filter Glorified / Endorsed</span>
                    </label>
                    <p class="filter-desc">Skip tracks promoting violence, shooting, weapons, or killing.</p>

                    <label class="filter-checkbox-label mt-2">
                        <input type="checkbox" asp-for="FilterPreferences.FilterViolenceMentioned" class="filter-checkbox" />
                        <span class="filter-title">Filter Narrative / Mentioned</span>
                    </label>
                    <p class="filter-desc">Strict mode: Also skip tracks merely mentioning violence in stories or news.</p>
                </div>
            </div>

            <!-- Substances Rules -->
            <div class="col-md-4">
                <div class="filter-option-box">
                    <div class="fw-bold mb-2" style="font-size: 0.85rem; color: #111;">Substances &amp; Drugs</div>
                    
                    <label class="filter-checkbox-label">
                        <input type="checkbox" asp-for="FilterPreferences.FilterSubstanceEndorsed" class="filter-checkbox" />
                        <span class="filter-title">Filter Glorified / Endorsed</span>
                    </label>
                    <p class="filter-desc">Skip tracks actively promoting illegal narcotics, hard drugs, or pills.</p>

                    <label class="filter-checkbox-label mt-2">
                        <input type="checkbox" asp-for="FilterPreferences.FilterSubstanceMentioned" class="filter-checkbox" />
                        <span class="filter-title">Filter Incidental / Mentioned</span>
                    </label>
                    <p class="filter-desc">Strict mode: Also skip tracks with casual alcohol or incidental mentions.</p>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
            <span class="text-muted" style="font-size: 0.8rem;">Changes take effect immediately on current queue and active playback.</span>
            <button type="submit" class="btn-flat">Save Filter Settings</button>
        </div>
    </form>
</div>

<div class="row g-4">
    <!-- Left Column: Now Playing & Lyrics -->
    <div class="col-lg-6">
        <span class="section-label">Currently Playing</span>
        
        @if (Model.PlaybackInfo?.CurrentlyPlaying?.FullTrack != null)
        {
            var track = Model.PlaybackInfo.CurrentlyPlaying;
            var fullTrack = track.FullTrack;
            var albumImg = fullTrack.Album?.Images?.FirstOrDefault()?.Url;

            <div class="clean-panel">
                <div class="now-playing-wrap">
                    @if (!string.IsNullOrWhiteSpace(albumImg))
                    {
                        <img src="@albumImg" alt="Album Cover" class="now-playing-cover" />
                    }
                    <div class="now-playing-info">
                        <h2 class="now-playing-title" id="trackName">@fullTrack.Name</h2>
                        <p class="now-playing-artist" id="trackArtist">
                            @string.Join(", ", fullTrack.Artists.Select(a => a.Name))
                        </p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (track.IsFlagged)
                            {
                                <span class="pill pill-red fw-bold">✕ Flagged: @(track.FlagReason ?? "Content Policy")</span>
                            }
                            else
                            {
                                <span class="pill pill-green fw-bold">✓ Clean</span>
                            }

                            @if (fullTrack.Explicit)
                            {
                                <span class="pill pill-red">Spotify Explicit [E]</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(track.Lyrics))
                            {
                                <span class="pill pill-blue">Lyrics Available</span>
                            }
                            else
                            {
                                <span class="pill" title="No synchronized community lyrics indexed on LRCLIB yet">No Lyrics Found</span>
                            }
                        </div>

                        @if (fullTrack.DurationMs > 0)
                        {
                            var duration = TimeSpan.FromMilliseconds(fullTrack.DurationMs);
                            <div class="text-muted" style="font-size: 0.8rem;">
                                Duration: @duration.Minutes:@duration.Seconds.ToString("D2")
                            </div>
                        }
                    </div>
                </div>

                <!-- Lyrics Panel -->
                @if (!string.IsNullOrWhiteSpace(track.Lyrics))
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="section-label mb-0">Lyrics</span>
                            <form method="post" class="d-inline">
                                <button type="submit" asp-page-handler="AnalyzeLyrics" class="btn-flat btn-flat-secondary" style="font-size: 0.75rem; padding: 0.25rem 0.5rem;">Analyze Stanza</button>
                            </form>
                        </div>
                        <div class="lyrics-preview">@track.Lyrics</div>
                    </div>
                }
                else
                {
                    <div class="mt-4 pt-3 border-top text-muted" style="font-size: 0.78rem;">
                        <em>ℹ️ No community lyrics are indexed yet for this song on LRCLIB or Genius. Content filtering evaluates official Spotify metadata ([E] tag) and artist catalogues.</em>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-box">
                <p class="mb-0">Nothing is currently playing on Spotify.</p>
            </div>
        }
    </div>

    <!-- Right Column: Music Queue List -->
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="section-label mb-0">
                Up Next Queue (@(Model.PlaybackInfo?.Queue?.Count ?? 0))
            </span>
        </div>

        @if (Model.PlaybackInfo?.Queue != null && Model.PlaybackInfo.Queue.Any())
        {
            <div class="clean-panel p-0">
                <table class="queue-table">
                    <thead>
                        <tr>
                            <th style="padding-left: 1rem; width: 36px;">#</th>
                            <th style="width: 48px;">Cover</th>
                            <th>Song / Artist</th>
                            <th style="width: 140px;">Safety Status</th>
                            <th style="padding-right: 1rem; text-align: right; width: 64px;">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 1; }
                        @foreach (var item in Model.PlaybackInfo.Queue)
                        {
                            var qTrack = item.FullTrack;
                            if (qTrack != null)
                            {
                                var qCover = qTrack.Album?.Images?.LastOrDefault()?.Url;
                                var qDuration = TimeSpan.FromMilliseconds(qTrack.DurationMs);
                                <tr class="queue-row @(item.IsFlagged ? "queue-row-flagged" : "")">
                                    <td class="queue-cell queue-idx" style="padding-left: 1rem;">@idx</td>
                                    <td class="queue-cell">
                                        @if (!string.IsNullOrWhiteSpace(qCover))
                                        {
                                            <img src="@qCover" alt="Cover" class="queue-thumb" />
                                        }
                                        else
                                        {
                                            <div class="queue-thumb d-flex align-items-center justify-content-center text-muted" style="font-size: 0.7rem;">-</div>
                                        }
                                    </td>
                                    <td class="queue-cell">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="queue-name">@qTrack.Name</span>
                                            @if (qTrack.Explicit)
                                            {
                                                <span class="pill pill-red" style="padding: 0.1rem 0.3rem; font-size: 0.65rem;">E</span>
                                            }
                                        </div>
                                        <div class="queue-sub">
                                            @string.Join(", ", qTrack.Artists.Select(a => a.Name))
                                        </div>
                                    </td>
                                    <td class="queue-cell">
                                        @if (item.IsFlagged)
                                        {
                                            <div class="d-flex flex-column align-items-start">
                                                <span class="pill pill-red" style="font-size: 0.7rem; padding: 0.15rem 0.45rem; font-weight: 600;">
                                                    ✕ Flagged
                                                </span>
                                                @if (!string.IsNullOrEmpty(item.FlagReason))
                                                {
                                                    <span class="text-danger" style="font-size: 0.65rem; margin-top: 2px;">
                                                        @item.FlagReason
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="pill pill-green" style="font-size: 0.7rem; padding: 0.15rem 0.45rem; font-weight: 600;">
                                                ✓ Clean
                                            </span>
                                        }
                                    </td>
                                    <td class="queue-cell text-muted" style="padding-right: 1rem; text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums;">
                                        @qDuration.Minutes:@qDuration.Seconds.ToString("D2")
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                <p class="mb-0">The queue is empty.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            console.log("Connecting to SSE endpoint...");
            const eventSource = new EventSource("/SpotifyEvents");

            eventSource.addEventListener("playbackInfo", function (event) {
                console.log("Playback info received, refreshing UI state.");
                location.reload();
            });

            eventSource.addEventListener("trackSkipped", function (event) {
                console.log("Track skipped event received:", event.data);
                const data = JSON.parse(event.data);
                alert(`Track Skipped: "${data.trackName}" by ${data.artist}.\nReason: ${data.reason}`);
            });

            eventSource.onerror = function (err) {
                console.error("EventSource connection error:", err);
                eventSource.close();
            };

            const profileSelect = document.getElementById('profileSelect');
            const explicitBox = document.querySelector('input[name="FilterPreferences.FilterSpotifyExplicit"]');
            const vEndBox = document.querySelector('input[name="FilterPreferences.FilterViolenceEndorsed"]');
            const sEndBox = document.querySelector('input[name="FilterPreferences.FilterSubstanceEndorsed"]');
            const vMenBox = document.querySelector('input[name="FilterPreferences.FilterViolenceMentioned"]');
            const sMenBox = document.querySelector('input[name="FilterPreferences.FilterSubstanceMentioned"]');
            const slider = document.getElementById('strictnessSlider');

            function syncProfileCheckboxes() {
                const val = profileSelect?.value;
                const strictness = parseInt(slider?.value || '5', 10);
                if (val === 'Islamic' || val === 'Christian' || val === 'FamilyFriendly') {
                    if (vEndBox) vEndBox.checked = true;
                    if (sEndBox) sEndBox.checked = true;
                    if (strictness >= 7) {
                        if (vMenBox) vMenBox.checked = true;
                        if (sMenBox) sMenBox.checked = true;
                    }
                }
            }

            profileSelect?.addEventListener('change', syncProfileCheckboxes);
            slider?.addEventListener('input', syncProfileCheckboxes);

            // GitHub Releases Update Checker (ALI-CLIENT-UPDATE)
            const currentAppVersion = "v1.0.0";
            fetch("https://api.github.com/repos/intisor/Alify/releases/latest")
                .then(res => res.ok ? res.json() : null)
                .then(release => {
                    if (release && release.tag_name && release.tag_name !== currentAppVersion) {
                        const banner = document.getElementById("updateBanner");
                        const tagSpan = document.getElementById("latestVersionTag");
                        const link = document.getElementById("updateDownloadLink");
                        if (banner && tagSpan && link) {
                            tagSpan.textContent = release.tag_name;
                            link.href = release.html_url || "https://github.com/intisor/Alify/releases/latest";
                            banner.classList.remove("d-none");
                        }
                    }
                })
                .catch(() => {});
        });
    </script>
}