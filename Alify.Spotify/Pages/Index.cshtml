@page
@model IndexModel
@{
    ViewData["Title"] = "Alify - Spotify Music Monitor";
}

<div class="container py-5" style="max-width: 820px;">
    <!-- Minimalist Hero -->
    <div class="clean-panel text-center py-5 mb-4">
        <h1 class="h2 fw-bold text-dark mb-2" style="letter-spacing: -0.03em;">Alify</h1>
        <p class="text-muted mb-4" style="font-size: 1.05rem;">
            Real-time Spotify playback monitoring, content stance filtering, and verified lyrics.
        </p>

        @if (Model.IsAuthenticated)
        {
            <div class="d-inline-flex flex-column align-items-center gap-3 p-4 border rounded-1 bg-white" style="border-color: var(--border-light) !important; min-width: 320px;">
                <span class="pill pill-green">● Spotify Connected</span>
                <a asp-page="/Dashboard/Dashboard" class="btn-flat w-100">Go to Dashboard</a>
                <form method="post" asp-page-handler="Logout" class="w-100">
                    <button type="submit" class="btn-flat btn-flat-secondary w-100">Disconnect</button>
                </form>
            </div>
        }
        else
        {
            <div class="d-inline-flex flex-column align-items-center gap-3 p-4 border rounded-1 bg-white" style="border-color: var(--border-light) !important; min-width: 320px;">
                <p class="text-muted small mb-2">Connect your Spotify account to inspect queue and active playback</p>
                <form method="post" asp-page-handler="Login" class="w-100">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="byokClientId" name="byokClientId" placeholder="e.g. ABCD1234EFGH5678 (optional)">
                        <label for="byokClientId">Bring Your Own Keys: Spotify Client ID</label>
                        <small class="text-muted">Leave blank to use configured Client ID. Each user provides their own ID to avoid Spotify's 5-user cap.</small>
                    </div>
                    <button type="submit" class="btn-flat w-100">
                        Connect with Spotify
                    </button>
                </form>
            </div>
        }

    <!-- Feature Highlights: Flat 3-column grid -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="clean-panel h-100">
                <span class="section-label">Real-Time Sync</span>
                <p class="text-muted small mb-0">Automatic SSE updates sync your live queue and currently playing track directly from Spotify.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="clean-panel h-100">
                <span class="section-label">Content Verification</span>
                <p class="text-muted small mb-0">Heuristic stance analysis and policy inspection evaluate track suitability automatically.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="clean-panel h-100">
                <span class="section-label">Verified Lyrics</span>
                <p class="text-muted small mb-0">Multi-source lyrics retrieval with automated ad stripping and normalized title matching.</p>
            </div>
        </div>
    </div>
</div>