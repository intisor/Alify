@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="max-w-xl mx-auto mt-12 p-8 bg-white rounded-lg shadow">
    <h1 class="text-3xl font-bold mb-4 text-blue-700">Welcome to Alify</h1>
    <p class="text-gray-700 mb-6">Stream music, view lyrics in chat format, and monitor your Spotify queue with ease.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-700">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-4 px-4 py-2 rounded bg-green-100 text-green-700">@Model.SuccessMessage</div>
    }

    <div class="flex gap-4 mt-6">
        @if (Model.IsAuthenticated)
        {
            <form method="post">
                <button type="submit" asp-page-handler="LogoutAsync" class="px-4 py-2 rounded bg-red-600 text-white font-semibold hover:bg-red-700 transition">Logout</button>
            </form>
            <a href="/Dashboard" class="px-4 py-2 rounded bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">Go to Dashboard</a>
        }
        else
        {
            <form method="get">
                <button type="submit" asp-page-handler="Login" class="px-4 py-2 rounded bg-green-600 text-white font-semibold hover:bg-green-700 transition">Login with Spotify</button>
            </form>
        }
    </div>
</div>
