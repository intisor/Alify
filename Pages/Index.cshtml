@page
@model IndexModel
@{
    ViewData["Title"] = "Login to Spotify";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Alify </h1>
    <p class="lead">Filter your playlists for faith-based listening</p>
    
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (Model.IsAuthenticated)
    {
        <div class="card mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <h5 class="card-title text-success" >✅ Connected to Spotify</h5>
                <p class="card-text">You're already logged in to Spotify. You can access the dashboard or logout.</p>
                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <a class="btn btn-success" href="/Dashboard">Go to Dashboard</a>
                    <a class="btn btn-primary" href="/ProductionDemo">Production Demo</a>
                    <form method="post" asp-page-handler="logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-secondary">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card mx-auto" style="max-width: 500px;">
            <div class="card-body">
                <h5 class="card-title">Connect to Spotify</h5>
                <p class="card-text">To use Alify, you need to connect your Spotify account. This allows us to monitor your music and filter inappropriate content.</p>
                <div class="d-grid">
                    <a class="btn btn-success btn-lg" asp-page-handler="login">
                        <i class="fab fa-spotify"></i> Login with Spotify
                    </a>
                </div>
                <small class="text-muted mt-2 d-block">
                    We only access your currently playing music and queue. Your playlists remain private.
                </small>
            </div>
        </div>
    }
</div>
