@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="max-w-xl mx-auto mt-12 p-8 bg-white rounded-lg shadow">
    <h1 class="text-3xl font-bold mb-4 text-blue-700">Welcome to Alify</h1>
    <p class="text-gray-700 mb-6">Stream music, view lyrics in chat format, and monitor your Spotify queue with ease.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 px-4 py-2 rounded bg-red-100 text-red-700">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-4 px-4 py-2 rounded bg-green-100 text-green-700">@Model.SuccessMessage</div>
    }

    <div class="flex flex-col md:flex-row gap-2 justify-center mt-6">
        @if (Model.IsAuthenticated)
        {
            <a class="px-4 py-2 rounded bg-green-600 text-white font-semibold hover:bg-green-700 transition" href="/Dashboard">Go to Dashboard</a>
            <a class="px-4 py-2 rounded bg-blue-600 text-white font-semibold hover:bg-blue-700 transition" href="/ProductionDemo">Production Demo</a>
            <form method="post" asp-page-handler="Logout" class="inline">
                <button type="submit" class="px-4 py-2 rounded border border-gray-400 text-gray-700 bg-white hover:bg-gray-100 font-semibold transition">Logout</button>
            </form>
        }
        else
        {
            <a class="px-4 py-2 rounded bg-green-600 text-white font-semibold hover:bg-green-700 transition text-lg flex items-center gap-2" asp-page-handler="Login">
                <i class="fab fa-spotify"></i> Login with Spotify
            </a>
        }
    </div>
</div>
