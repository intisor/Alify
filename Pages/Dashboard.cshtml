@page
@model DashboardModel

<h2>Now Playing</h2>

@if (Model.TrackName != null)
{
    <div>
        <p><strong>@Model.TrackName</strong> by @Model.ArtistName</p>
        <dl>
            <dt>Lyrics:</dt>
            <dd><pre>@Model.Lyric</pre></dd>
        </dl>
        <img src="@Model.AlbumArtUrl" width="300" />
    </div>
}
else
{
    <p>No track currently playing.</p>
}
<div>
    <h3>Queue</h3>
    @if (Model.PlaybackInfo?.Queue?.Any() == true)
    {
        <ul>
            @foreach (var track in Model.PlaybackInfo.Queue ?? new List<SpotifyAPI.Web.FullTrack>())
            {
                <li>@track.Name by @track.Artists[0].Name @(Model.PlaybackInfo.IsFlagged.Contains(track.Uri) ? "(Flagged)" : "")</li>
            }
        </ul>
    }
    else
    {
        <p>Queue is empty.</p>
    }
</div>

<div>
    <p>Status: @Model.StatusMessage</p>
    <form method="post">
        <button asp-page-handler="StartMonitor">Start Monitoring</button>
         <button asp-page-handler="StopMonitor">Stop Monitoring</button>
    </form>
</div>

