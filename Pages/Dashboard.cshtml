@page
@model DashboardModel

<h2>Now Playing</h2>

@if (Model.PlaybackInfo?.CurrentlyPlaying?.FullTrack != null)
{
    var track = Model.PlaybackInfo.CurrentlyPlaying;
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@track.FullTrack.Name</h5>
            <p class="card-text">by @track.FullTrack.Artists.FirstOrDefault()?.Name</p>
            
            <div class="mb-2">
                @if (track.IsFlagged)
                {
                    <span class="badge bg-warning text-dark">⚠️ Flagged</span>
                }
                else
                {
                    <span class="badge bg-success">✅ Clean</span>
                }
                
                @if (track.FullTrack.Explicit)
                {
                    <span class="badge bg-danger">Explicit</span>
                }
                
                @if (!string.IsNullOrWhiteSpace(track.Lyrics))
                {
                    <span class="badge bg-info">Has Lyrics</span>
                }
                else
                {
                    <span class="badge bg-secondary">No Lyrics</span>
                }
            </div>
            
            @if (!string.IsNullOrWhiteSpace(track.FullTrack.Album.Images.FirstOrDefault()?.Url))
            {
                <img src="@track.FullTrack.Album.Images.FirstOrDefault()?.Url" width="200" class="mb-3" />
            }
        </div>
    </div>
}

<div class="mt-4">
    <h3>Queue Monitoring</h3>
    <p>Status: 
        @if (Model.IsMonitoring)
        {
            <span class="text-success"><strong>🟢 Active</strong></span>
        }
        else
        {
            <span class="text-secondary"><strong>🔴 Stopped</strong></span>
        }
    </p>
    <p class="text-muted">@Model.StatusMessage</p>
    
    <div class="btn-group" role="group">
        <form method="post" class="d-inline">
            @if (Model.IsMonitoring)
            {
                <button type="submit" asp-page-handler="StopMonitor" class="btn btn-danger">Stop Monitoring</button>
            }
            else
            {
                <button type="submit" asp-page-handler="StartMonitor" class="btn btn-success">Start Monitoring</button>
            }
        </form>
        <form method="post" class="d-inline">
            <button type="submit" asp-page-handler="RefreshData" class="btn btn-outline-primary">🔄 Refresh Data</button>
        </form>
    </div>
</div>
