@page
@model DashboardModel

<h2 class="text-2xl font-bold mb-4">Now Playing</h2>

@if (Model.PlaybackInfo?.CurrentlyPlaying?.FullTrack != null)
{
    var track = Model.PlaybackInfo.CurrentlyPlaying;
    <div class="rounded-lg shadow bg-white mb-6 p-6 flex flex-col items-center">
        <h5 class="text-xl font-semibold mb-2">@track.FullTrack.Name</h5>
        <p class="text-gray-700 mb-2">by @track.FullTrack.Artists.FirstOrDefault()?.Name</p>
        <div class="flex flex-wrap gap-2 mb-4">
            @if (track.IsFlagged)
            {
                <span class="px-2 py-1 rounded bg-yellow-200 text-yellow-900 text-sm font-medium">⚠️ Flagged</span>
            }
            else
            {
                <span class="px-2 py-1 rounded bg-green-200 text-green-900 text-sm font-medium">✅ Clean</span>
            }
            @if (track.FullTrack.Explicit)
            {
                <span class="px-2 py-1 rounded bg-red-200 text-red-900 text-sm font-medium">Explicit</span>
            }
            @if (!string.IsNullOrWhiteSpace(track.Lyrics))
            {
                <span class="px-2 py-1 rounded bg-blue-200 text-blue-900 text-sm font-medium">Has Lyrics</span>
            }
            else
            {
                <span class="px-2 py-1 rounded bg-gray-200 text-gray-700 text-sm font-medium">No Lyrics</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(track.FullTrack.Album.Images.FirstOrDefault()?.Url))
        {
            <img src="@track.FullTrack.Album.Images.FirstOrDefault()?.Url" width="200" class="mb-3 rounded shadow" />
        }
    </div>
}

<div class="mt-8">
    <h3 class="text-xl font-semibold mb-2">Queue Monitoring</h3>
    <p>Status:
        @if (Model.IsMonitoring)
        {
            <span class="text-green-600 font-bold">🟢 Active</span>
        }
        else
        {
            <span class="text-gray-500 font-bold">🔴 Stopped</span>
        }
    </p>
    <p class="text-gray-500">@Model.StatusMessage</p>
    <div class="flex gap-4 mt-4">
        <form method="post">
            @if (Model.IsMonitoring)
            {
                <button type="submit" asp-page-handler="StopMonitor" class="px-4 py-2 rounded bg-red-600 text-white font-semibold hover:bg-red-700 transition">Stop Monitoring</button>
            }
            else
            {
                <button type="submit" asp-page-handler="StartMonitor" class="px-4 py-2 rounded bg-green-600 text-white font-semibold hover:bg-green-700 transition">Start Monitoring</button>
            }
        </form>
        <form method="post">
            <button type="submit" asp-page-handler="RefreshData" class="px-4 py-2 rounded bg-blue-100 text-blue-700 font-semibold hover:bg-blue-200 transition">🔄 Refresh Data</button>
        </form>
    </div>
</div>
