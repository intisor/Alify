@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-lg mx-auto mt-16 p-8 bg-white rounded-lg shadow">
    <h1 class="text-2xl font-bold text-red-600 mb-4">An error occurred</h1>
    <p class="text-gray-700 mb-2">Sorry, something went wrong while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-gray-500 text-sm">Request ID: <span class="font-mono">@Model.RequestId</span></p>
    }
    <a href="/" class="inline-block mt-6 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">Go Home</a>
</div>
