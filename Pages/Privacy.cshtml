@page "/privacy"
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-2xl mx-auto p-8 bg-white rounded-lg shadow mt-8">
    <h1 class="text-2xl font-bold mb-4">Privacy Policy</h1>
    <p class="text-gray-700 mb-2">Your privacy is important to us. This page describes how we handle your data.</p>
    <ul class="list-disc pl-6 text-gray-600 mb-4">
        <li>We do not store your Spotify credentials.</li>
        <li>Lyrics and playback data are fetched in real-time and not retained.</li>
        <li>We use cookies only for session management and authentication.</li>
    </ul>
    <p class="text-gray-500">For more information, contact support@alify.com.</p>
</div>
