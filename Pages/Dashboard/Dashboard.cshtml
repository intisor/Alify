@page
@model Alify.Pages.DashboardModel
@using SpotifyAPI.Web

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold mb-4">Now Playing</h2>
        @if (Model.PlaybackInfo?.CurrentlyPlaying?.FullTrack != null)
        {
            var track = Model.PlaybackInfo.CurrentlyPlaying;
            <div class="rounded-lg shadow bg-white mb-6 p-6" id="nowPlaying">
                <div class="flex flex-col md:flex-row md:items-start gap-6">
                    @if (!string.IsNullOrWhiteSpace(track.FullTrack.Album.Images.FirstOrDefault()?.Url))
                    {
                        <img src="@track.FullTrack.Album.Images.FirstOrDefault()?.Url" width="200" class="mb-3 rounded shadow mx-auto md:mx-0" />
                    }
                    <div class="flex-grow text-center md:text-left">
                        <h5 class="text-2xl font-semibold mb-1" id="trackName">@track.FullTrack.Name</h5>
                        <p class="text-gray-700 mb-4 text-lg" id="trackArtist">by @track.FullTrack.Artists.FirstOrDefault()?.Name</p>
                        <div class="flex flex-wrap gap-2 mb-4 justify-center md:justify-start">
                            @if (track.IsFlagged)
                            {
                                <span class="px-2 py-1 rounded bg-yellow-200 text-yellow-900 text-sm font-medium">⚠️ Flagged</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 rounded bg-green-200 text-green-900 text-sm font-medium">✓ Clean</span>
                            }
                            @if (track.FullTrack.Explicit)
                            {
                                <span class="px-2 py-1 rounded bg-red-200 text-red-900 text-sm font-medium">Explicit</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(track.Lyrics))
                            {
                                <span class="px-2 py-1 rounded bg-blue-200 text-blue-900 text-sm font-medium">Has Lyrics</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 rounded bg-gray-200 text-gray-700 text-sm font-medium">No Lyrics</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-lg shadow bg-white mb-6 p-6 flex flex-col items-center justify-center h-64">
                <p class="text-gray-500">Nothing is currently playing.</p>
            </div>
        }
    </div>
    <div>
        <h2 class="text-2xl font-bold mb-4">Up Next</h2>
        @if (Model.PlaybackInfo?.Queue != null && Model.PlaybackInfo.Queue.Any())
        {
            <div class="rounded-lg shadow bg-white mb-6 p-6 max-h-96 overflow-y-auto">
                <ul class="space-y-4">
                    @foreach (var track in Model.PlaybackInfo.Queue)
                    {
                        var queueTrack = track.FullTrack;
                        if (queueTrack != null)
                        {
                            <li class="flex items-center space-x-4 p-2 rounded-md hover:bg-gray-50">
                                @if (!string.IsNullOrWhiteSpace(queueTrack.Album.Images.LastOrDefault()?.Url))
                                {
                                    <img src="@queueTrack.Album.Images.LastOrDefault()?.Url" width="50" height="50" class="rounded shadow flex-shrink-0" />
                                }
                                <div class="overflow-hidden">
                                    <h6 class="font-semibold truncate">@queueTrack.Name</h6>
                                    <p class="text-gray-600 text-sm truncate">@string.Join(", ", queueTrack.Artists.Select(a => a.Name))</p>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="rounded-lg shadow bg-white mb-6 p-6 flex items-center justify-center h-64">
                <p class="text-gray-500 text-center">The queue is empty.</p>
            </div>
        }
    </div>
</div>


<div class="flex flex-col md:flex-row gap-2 justify-center mt-8">
    <form method="post">
        @if (Model.IsMonitoring)
        {
            <button type="submit" asp-page-handler="StopMonitor" class="px-4 py-2 rounded bg-red-600 text-white font-semibold hover:bg-red-700 transition">Stop Monitoring</button>
        }
        else
        {
            <button type="submit" asp-page-handler="StartMonitor" class="px-4 py-2 rounded bg-green-600 text-white font-semibold hover:bg-green-700 transition">Start Monitoring</button>
        }
    </form>
    <form method="post">
        <button type="submit" asp-page-handler="RefreshData" class="px-4 py-2 rounded bg-blue-100 text-blue-700 font-semibold hover:bg-blue-200 transition">🔄 Refresh Data</button>
    </form>
</div>
<p class="text-gray-500 text-center mt-4">@Model.StatusMessage</p>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            console.log("Connecting to SSE endpoint...");
            const eventSource = new EventSource("/SpotifyEvents");

            eventSource.addEventListener("playbackInfo", function (event) {
                console.log("Playback info received, reloading page.");
                // Simple reload to update the whole UI state including queue
                location.reload();
            });

            eventSource.addEventListener("trackSkipped", function (event) {
                console.log("Track skipped event received:", event.data);
                const data = JSON.parse(event.data);

                // Display a notification
                alert(`Track Skipped: "${data.trackName}" by ${data.artist}.\nReason: ${data.reason}`);
            });

            eventSource.onerror = function (err) {
                console.error("EventSource failed:", err);
                eventSource.close();
            };
        });
    </script>
}