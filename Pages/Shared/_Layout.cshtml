<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alify</title>
    <!-- TailwindCSS CDN for quick setup; switch to npm build for production -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Alify.styles.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <header>
        <nav class="bg-white border-b shadow mb-3">
            <div class="container mx-auto px-4 flex items-center justify-between h-16">
                <a class="text-xl font-bold text-blue-600" asp-area="" asp-page="/Index">Alify</a>
                <div class="flex space-x-4">
                    <a class="text-gray-700 hover:text-blue-600 transition" asp-area="" asp-page="/Index">Home</a>
                    <a class="text-gray-700 hover:text-blue-600 transition" asp-area="" asp-page="/LyricsView">Lyrics Chat</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mx-auto px-4 flex-1">
        <main role="main" class="py-6">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t text-gray-500 py-4 mt-8">
        <div class="container mx-auto px-4 text-center">
            &copy; 2025 - Alify - <a class="text-blue-600 hover:underline" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
