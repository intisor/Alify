@page "/callback"
@model Alify.Pages.callbackModel
@{
    ViewData["Title"] = "Spotify Authentication";
}

<div class="text-center">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Processing...</span>
    </div>
    <h3 class="mt-3">Processing Spotify Authentication...</h3>
    <p class="text-muted">Please wait while we complete your login.</p>
</div>

<script>
    // Auto-redirect if this page is shown for too long (fallback)
    setTimeout(function() {
        window.location.href = '/Index';
    }, 15000);
</script>
