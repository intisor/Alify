@page
@model Alify.Pages.LyricsViewModel
@{
    ViewData["Title"] = "Lyrics Search";
}

<!-- Search Form (only show if no lyrics loaded yet) -->
@if (Model.LyricMapping == null)
{
    <div class="max-w-2xl mx-auto p-6 bg-white rounded-lg shadow mb-6">
        <h2 class="text-2xl font-bold mb-4 text-gray-900">🔍 Search Lyrics</h2>
        <form id="searchForm" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="artistInput" class="block text-sm font-medium text-gray-700 mb-1">Artist</label>
                    <input 
                        type="text" 
                        id="artistInput" 
                        name="artist" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                        placeholder="e.g., The Weeknd"
                    />
                </div>
                <div>
                    <label for="songInput" class="block text-sm font-medium text-gray-700 mb-1">Song Title</label>
                    <input 
                        type="text" 
                        id="songInput" 
                        name="query" 
                        required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                        placeholder="e.g., Blinding Lights"
                    />
                </div>
            </div>
            <button 
                type="submit" 
                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition duration-200"
            >
                🔍 Search Lyrics
            </button>
        </form>

        <!-- Loading State -->
        <div id="loadingState" class="hidden mt-4 text-center">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            <p class="mt-2 text-gray-600">Searching Genius...</p>
        </div>

        <!-- Error State -->
        <div id="errorState" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-red-800 font-medium">❌ Error</p>
            <p id="errorMessage" class="text-red-700"></p>
        </div>

        <!-- Search Results -->
        <div id="searchResults" class="hidden mt-6">
            <h3 class="text-xl font-semibold mb-4 text-gray-900">Search Results</h3>
            <div id="resultsList" class="space-y-3"></div>
        </div>
    </div>
}
else
{
    <!-- Show "New Search" button when lyrics are displayed -->
    <div class="max-w-2xl mx-auto mb-4 text-center">
        <a href="/LyricsView" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg transition">
            ← New Search
        </a>
    </div>
}

<!-- Lyrics Display (WhatsApp-style chat) -->
<div class="max-w-2xl mx-auto p-6 bg-white rounded-lg shadow">
@if (Model.LyricMapping != null)
{
    <h2 class="text-2xl font-bold mb-4 text-gray-900">@Model.TrackName</h2>
    <p class="text-gray-600 mb-6">by @Model.MainArtist</p>
    
    foreach (var line in Model.LyricMapping.Lines)
    {
        if (line.IsAnnotation)
        {
            <div class="flex justify-center mb-2">
                <div class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-sm font-semibold">@line.Text</div>
            </div>
        }
        else
        {
            var isMainArtist = !string.IsNullOrEmpty(line.Artist) && line.Artist == Model.MainArtist;
            var bubbleAlign = isMainArtist ? "justify-end" : "justify-start";
            var bubbleColor = isMainArtist ? "bg-blue-100 text-blue-900" : "bg-gray-100 text-gray-900";
            <div class="flex @bubbleAlign mb-2">
                <div class="px-4 py-2 rounded-lg shadow @bubbleColor max-w-lg">
                    @if (!string.IsNullOrEmpty(line.Artist))
                    {
                        <div class="text-xs font-semibold text-gray-500 mb-1">@line.Artist</div>
                    }
                    <div class="text-base">@line.Text</div>
                </div>
            </div>
        }
    }
}
else
{
    <p class="text-gray-500 text-center py-8">Use the search form above to find lyrics.</p>
}
</div>

@section Scripts {
    <script src="~/js/lyrics-search.js"></script>
}
